                  <photoshop:LayerText>Expriences :</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>IranOpen 2023  IranOpen 2024  IranOpen 2025  QFR RCJ 2026  </photoshop:LayerName>
                  <photoshop:LayerText>IranOpen 2023  IranOpen 2024  IranOpen 2025  QFR RCJ 2026  </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Mohammadamin is responsible for the electronics division of our</photoshop:LayerName>
                  <photoshop:LayerText>Mohammadamin is responsible for the electronics division of our team. He is highly skilled in working with Altium and demonstrates exceptional proficiency in soldering. This year, he has incorporated significant innovation and creativity into the design and development of our electronic boards. In addition, he worked with Altium Designer to create the boards and collaborated closely in his design and development.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Mechanical Specialist</photoshop:LayerName>
                  <photoshop:LayerText>Mechanical Specialist</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Arvin MirzaAghayan</photoshop:LayerName>
                  <photoshop:LayerText>Arvin MirzaAghayan</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Reza Bagheri</photoshop:LayerName>
                  <photoshop:LayerText>Reza Bagheri</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Expriences :</photoshop:LayerName>
                  <photoshop:LayerText>Expriences :</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>IranOpen 2023  IranOpen 2024  IranOpen 2025  QFR RCJ 2026      </photoshop:LayerName>
                  <photoshop:LayerText>IranOpen 2023  IranOpen 2024  IranOpen 2025  QFR RCJ 2026              </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>IranOpen 2025  QFR RCJ 2026              </photoshop:LayerName>
                  <photoshop:LayerText>IranOpen 2025  QFR RCJ 2026              </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Arvin is the head of our programming team. He has gained valuab</photoshop:LayerName>
                  <photoshop:LayerText>Arvin is the head of our programming team. He has gained valuable experience and has played an essential role in our team‚Äôs success. Arvin is a  programmer with strong expertise in image processing, highly proficient in Python and skilled in C++. He and Reza work closely on software and algorithms, forming the core of the programming team. With his experience, Arvin plays a key role in problem-solving and helps overcome programming challenges reliably.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>XL330</photoshop:LayerName>
                  <photoshop:LayerText>XL330</photoshop:LayerText>
               </rdf:li>
